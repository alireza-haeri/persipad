#!/usr/bin/env bash
# build_apk — build the Android APK for this checkout, and install it if asked.
#
#   bin/build_apk                    # community flavor, debug, ABI chosen for you
#   bin/build_apk --install          # ...and `adb install -r` it on the device/AVD
#   bin/build_apk --install --launch # ...and launch the app on the device/AVD
#   bin/build_apk --install --avd    # boot an AVD if nothing is attached, then install
#   bin/build_apk --install --avd=storypad_dev
#   bin/build_apk --release          # release build (needs the RELEASE_KEYSTORE_* env vars)
#   bin/build_apk --release --sign-debug
#                                    # release build signed with the Android debug key:
#                                    # installable today, no secrets, ~4x smaller than debug
#   bin/build_apk --abi all          # every ABI (biggest, slowest, always installable)
#   bin/build_apk --abi x86_64       # force one: arm64 | x86_64 | arm | x86
#   bin/build_apk --flavor storypad  # needs private_keys/ (see ai/ENVIRONMENT.md)
#   bin/build_apk --dns-server=8.8.8.8
#                                    # AVD: hand the guest a resolver (see below)
#                                    # (also honoured: NOTELY_DNS_SERVER=8.8.8.8)
#   bin/build_apk --no-dns-server     # ...and never pass one, even on a stub-resolver host
#   bin/build_apk --compile-sdk=36   # build against the platform this machine has
#   bin/build_apk --no-ndk           # skip Flutter's NDK check (only works when :jni is absent)
#   bin/build_apk -v                 # stream live Gradle/Flutter output instead of spinner
#   bin/build_apk -PnotelyMinify=false
#                                    # any Gradle project property, as `gradle -P` spells it
#
# The ABI default is `auto`: the attached device's (or AVD's, or host's) architecture
# mapped to a Flutter target platform. An arm64-only APK does not install on an x86_64
# emulator, and a universal one wastes a minute on every build.
#
# `--dns-server` exists because an emulator inherits the host's DNS in a way that
# quietly fails on a box using systemd-resolved's stub (127.0.0.53): the guest then
# cannot resolve anything, and Google sign-in dies with `Failed host lookup:
# 'oauth2.googleapis.com' (OS Error: No address associated with hostname, errno = 7)`
# — which looks like an OAuth bug but is pure DNS. It is now automatic: when the host
# resolves only through a stub, the AVD is booted with the host's real upstream
# resolver (or 8.8.8.8,1.1.1.1 when that cannot be read), so nobody has to remember
# the flag. An explicitly passed `--dns-server` still wins, and `--no-dns-server`
# turns the behaviour off. The AVD has to be (re)booted for any of it to apply.
# See ai/ENVIRONMENT.md §2.2c.
#
# Why this exists next to .github/workflows/android.yml: CI takes ~15 minutes per
# attempt and grades you only at the end; a laptop takes ~2 minutes the first time and
# under a minute after that, with the APK and `adb` on the same machine. CI is for
# artifacts you want to keep, this is for the loop you are in now (D-038).
set -euo pipefail
cd "$(dirname "$0")/.."
source "$(dirname "$0")/helpers"

FLAVOR=community
MODE=debug
ABI=auto
INSTALL=0
LAUNCH=0
AVD=""
VERBOSE=""
DNS_SERVER="${NOTELY_DNS_SERVER:-}"
NO_DNS_SERVER=0
AVD_BOOTED=0
SIGN_DEBUG=0

while [ $# -gt 0 ]; do
  case "$1" in
    --install) INSTALL=1 ;;
    --launch)  INSTALL=1; LAUNCH=1 ;;
    --release) MODE=release ;;
    --sign-debug) SIGN_DEBUG=1 ;;
    --debug)   MODE=debug ;;
    -v|--verbose) VERBOSE="-v" ;;
    --avd)
      if [ $# -ge 2 ] && [ "${2#-}" = "$2" ]; then
        AVD="$2"; shift
      else
        AVD="auto"
      fi
      ;;
    --avd=*)   AVD="${1#*=}"; [ -n "$AVD" ] || AVD="auto" ;;
    --dns-server)
      DNS_SERVER="${2:?--dns-server needs an address like 8.8.8.8}"; shift ;;
    --dns-server=*) DNS_SERVER="${1#*=}" ;;
    --no-dns-server) NO_DNS_SERVER=1; DNS_SERVER="" ;;
    --flavor)  FLAVOR="${2:?--flavor needs a value}"; shift ;;
    --flavor=*) FLAVOR="${1#*=}" ;;
    --abi)     ABI="${2:?--abi needs a value}"; shift ;;
    --abi=*)   ABI="${1#*=}" ;;
    --compile-sdk)
      CSDK="${2:?--compile-sdk needs a value}"; shift
      export ORG_GRADLE_PROJECT_notelyCompileSdk="${CSDK%%.*}"
      if [ "$CSDK" != "${CSDK%%.*}" ]; then
        export ORG_GRADLE_PROJECT_notelyCompileSdkMinor="${CSDK#*.}"
      else
        unset ORG_GRADLE_PROJECT_notelyCompileSdkMinor
      fi
      ;;
    --compile-sdk=*)
      CSDK="${1#*=}"
      export ORG_GRADLE_PROJECT_notelyCompileSdk="${CSDK%%.*}"
      if [ "$CSDK" != "${CSDK%%.*}" ]; then
        export ORG_GRADLE_PROJECT_notelyCompileSdkMinor="${CSDK#*.}"
      else
        unset ORG_GRADLE_PROJECT_notelyCompileSdkMinor
      fi
      ;;
    --ndk)     export ORG_GRADLE_PROJECT_notelyNdkVersion="${2:?--ndk needs a value}"; shift ;;
    --ndk=*)   export ORG_GRADLE_PROJECT_notelyNdkVersion="${1#*=}" ;;
    --no-ndk)  export ORG_GRADLE_PROJECT_notelyNdkVersion=none ;;
    # Gradle project properties, the same spelling `gradle -P` uses. Gradle reads
    # ORG_GRADLE_PROJECT_<name> from the environment, so `-PnotelyMinify=false`
    # becomes ORG_GRADLE_PROJECT_notelyMinify=false for the build.
    -P|-P*)
      GPAIR=""
      if [ "$1" = "-P" ]; then
        GPAIR="${2:-}"; shift
      else
        GPAIR="${1#-P}"
      fi
      if [ -z "$GPAIR" ] || [ "${GPAIR#*=}" = "$GPAIR" ]; then
        echo "bin/build_apk: -P needs name=value (e.g. -PnotelyMinify=false)" >&2; exit 2
      fi
      NAME="${GPAIR%%=*}"; VALUE="${GPAIR#*=}"
      case "$NAME" in
        ""|*[!A-Za-z0-9_]*)
          echo "bin/build_apk: -P$NAME: only letters, digits and '_' are supported here — export ORG_GRADLE_PROJECT_... yourself" >&2
          exit 2 ;;
      esac
      export "ORG_GRADLE_PROJECT_$NAME=$VALUE"
      ;;
    -h|--help) awk 'NR>1 && !/^#/{exit} NR>1{sub(/^# ?/,""); print}' "$0"; exit 0 ;;
    *) echo "bin/build_apk: unknown argument '$1' (try --help)" >&2; exit 2 ;;
  esac
  shift
done

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }
die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
warn() { printf '\033[33m%s\033[0m\n' "$*" >&2; }

# ---------------------------------------------------------------- prerequisites
FLUTTER="${FLUTTER_BIN:-}"
if [ -z "$FLUTTER" ]; then
  if command -v flutter >/dev/null 2>&1; then
    FLUTTER=$(command -v flutter)
  elif [ -x "$HOME/development/flutter_stable/bin/flutter" ]; then
    FLUTTER="$HOME/development/flutter_stable/bin/flutter"
  fi
fi
[ -n "$FLUTTER" ] && [ -x "$FLUTTER" ] || die "flutter is not on PATH — install Flutter 3.50.0+ (ai/ENVIRONMENT.md §2.1)."

SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-}}"
if [ -z "$SDK" ] || [ ! -d "$SDK" ]; then
  for guess in "$HOME/Android/Sdk" "$HOME/Library/Android/sdk" /usr/lib/android-sdk /opt/android-sdk; do
    [ -d "$guess" ] && { SDK="$guess"; break; }
  done
fi
[ -n "$SDK" ] && [ -d "$SDK" ] || die "no Android SDK found — set ANDROID_HOME (Android Studio installs it under ~/Android/Sdk).

Run bin/android_doctor for a full report of what is installed."
export ANDROID_HOME="$SDK"
export ANDROID_SDK_ROOT="$SDK"

# Android Studio does not put platform-tools/ or emulator/ on PATH by default.
if ! command -v adb >/dev/null 2>&1 && [ -x "$SDK/platform-tools/adb" ]; then
  export PATH="$SDK/platform-tools:$PATH"
fi

EMULATOR_BIN=""
if command -v emulator >/dev/null 2>&1; then
  EMULATOR_BIN=$(command -v emulator)
elif [ -x "$SDK/emulator/emulator" ]; then
  EMULATOR_BIN="$SDK/emulator/emulator"
fi

command -v java >/dev/null || die "no java — the Android build needs a JDK 17+ (bin/android_doctor shows what you have)."
JAVA_MAJOR=$(java -version 2>&1 | sed -n 's/.*version "\([0-9]*\).*/\1/p' | head -1 || true)
[ "${JAVA_MAJOR:-0}" -ge 17 ] 2>/dev/null || die "JDK ${JAVA_MAJOR:-unknown} is too old — the Android build needs 17+."

if [ "$FLAVOR" != "community" ] && [ ! -d bin/.tmp/private_keys ]; then
  die "flavor '$FLAVOR' needs bin/.tmp/private_keys (keystores, dart-defines). Only 'community' builds without them."
fi

if [ -f "$HOME/.gradle/init.d/notely-google-mirror.gradle.kts" ]; then
  die "found old broken mirror script ~/.gradle/init.d/notely-google-mirror.gradle.kts — run 'bin/android_doctor --mirror' to replace it with the working .gradle script."
fi

# ---------------------------------------------------------------- device & AVD helpers
first_online_device() {
  command -v adb >/dev/null 2>&1 || return 0
  # ANDROID_SERIAL wins; then the only device; then the emulator — a phone stays
  # plugged in next to the AVD all day, and every adb call here (boot wait, DNS
  # check, install, launch) means the emulator in that case. Two phones and no
  # emulator stay ambiguous: print nothing so the caller can say what to set.
  if [ -n "${ANDROID_SERIAL:-}" ]; then
    printf '%s\n' "$ANDROID_SERIAL"
    return 0
  fi
  devices=$(adb devices 2>/dev/null | awk 'NF>=2 && $1!="*" && $2=="device" {print $1}')
  count=$(printf '%s\n' "$devices" | grep -c . || true)
  if [ "$count" = "1" ]; then
    printf '%s\n' "$devices"
    return 0
  fi
  if [ "$count" -gt 1 ]; then
    emulators=$(printf '%s\n' "$devices" | grep '^emulator-' || true)
    if [ "$(printf '%s\n' "$emulators" | grep -c . || true)" = "1" ]; then
      printf '%s\n' "$emulators"
    fi
  fi
}

# True when the host resolves names exclusively through a local stub resolver
# (systemd-resolved on 127.0.0.53, or dnsmasq on 127.0.0.1). The emulator reads
# the host's DNS at boot and historically fails to follow that stub, which is
# exactly the broken-DNS state `--dns-server` fixes.
host_dns_is_stub() {
  [ -r /etc/resolv.conf ] || return 1
  awk '
    $1 == "nameserver" {
      if ($2 ~ /^(127\.0\.0\.(1|53)|::1)$/) stub = 1; else real = 1
    }
    END { exit (stub && !real) ? 0 : 1 }
  ' /etc/resolv.conf
}

# The real upstream resolvers this host uses (skipping loopback stubs), because an
# AVD can reach them through NAT while it cannot follow 127.0.0.53. `resolvectl dns`
# prints them per link ("Link 2 (enp4s0): 192.168.1.1 1.1.1.1"); older boxes use
# `systemd-resolve --status`. IPv4 only on purpose: an IPv6 resolver is often not
# routable from the guest's NAT, and a wrong guess is worse than the fallback.
host_upstream_dns() {
  local out=""
  if command -v resolvectl >/dev/null 2>&1; then
    out=$(resolvectl dns 2>/dev/null || true)
  elif command -v systemd-resolve >/dev/null 2>&1; then
    out=$(systemd-resolve --status 2>/dev/null | sed -n 's/^[[:space:]]*DNS Servers:[[:space:]]*//p' || true)
  fi
  printf '%s\n' "$out" | tr ' ,' '\n\n' \
    | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' \
    | grep -vE '^(127\.|0\.|255\.)' \
    | awk '!seen[$0]++' | head -2 | paste -sd, - || true
}

# Resolve a Google host from inside the guest and classify the ANSWER.
#
# `ping` is the resolver client every AVD image has, and its output names the
# address it resolved — the address is the point, not the reply. A guest behind a
# fake-IP DNS (Clash/mihomo-style TUN, default pool 198.18.0.1/16) resolves Google
# to a bogus private address and the ping *succeeds*, because the fake-IP layer
# answers ICMP itself (ttl 255, ~1 ms). That is exactly how a "healthy" ping hid a
# broken sign-in: the app's HTTPS went to that bogus address and never reached
# Google, while Chrome logged in fine because it uses its own secure DNS.
#
#   ok <ip>        a plausible public address
#   fake <ip>      a private/benchmark address that cannot be Google
#   unresolvable   no answer at all
emulator_dns_verdict() {
  local serial="$1" out ip
  [ -n "$serial" ] || { echo unresolvable; return 0; }
  out=$(timeout 20 adb -s "$serial" shell ping -c1 -W2 oauth2.googleapis.com 2>/dev/null || true)
  ip=$(printf '%s\n' "$out" | tr -d '\r' | grep -o '([0-9][0-9.]*)' | head -1 | tr -d '()')
  [ -n "$ip" ] || { echo unresolvable; return 0; }
  case "$ip" in
    198.18.*|198.19.*|10.*|127.*|0.*|169.254.*|192.168.*|100.6[4-9].*|100.[7-9][0-9].*|100.1[0-2][0-9].*|172.1[6-9].*|172.2[0-9].*|172.3[01].*)
      echo "fake $ip" ;;
    *) echo "ok $ip" ;;
  esac
}

# Turn that verdict into something the user can act on. `$2` names the device.
explain_dns_verdict() {
  case "$1" in
    ok*) return 0 ;;
    "fake "*)
      warn "$2 resolves oauth2.googleapis.com to ${1#fake } — not a Google address, so sign-in will fail."
      warn "Something on this host answers DNS with fake IPs (Clash/mihomo-style TUN in fake-ip mode,"
      warn "default pool 198.18.0.1/16). A ping to it 'works'; the app's HTTPS to it does not, and Chrome"
      warn "still logs in because it uses its own secure DNS. Fix one, then try sign-in again:"
      warn "  1) proxy config (best): add fake-ip-filter entries for *.googleapis.com, *.google.com,"
      warn "     accounts.google.com — or set dns.enhanced-mode: redir-host"
      warn "  2) guest side, no reboot: adb shell settings put global private_dns_mode hostname"
      warn "     adb shell settings put global private_dns_specifier dns.google   (then re-ping: the IP must change)"
      warn "  3) a resolver the hijack does not see: --dns-server=8.8.8.8 (ENVIRONMENT.md §2.2c)"
      ;;
    *)
      warn "$2 cannot resolve oauth2.googleapis.com, so Google sign-in will fail."
      warn "Check the host's internet first, then try a different resolver:"
      warn "    bin/build_apk --install --avd=<name> --dns-server=1.1.1.1"
      ;;
  esac
}

has_pending_device() {
  command -v adb >/dev/null 2>&1 || return 1
  adb devices 2>/dev/null | awk 'NF>=2 && $1!="*" && ($2=="offline" || $2=="authorizing") {found=1; exit} END {exit !found}'
}

wait_for_boot() {
  local timeout="${1:-120}" pid="${2:-}" elapsed=0 serial boot=""
  while [ "$elapsed" -lt "$timeout" ]; do
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      echo "" >&2
      warn "emulator exited before booting. Last lines of /tmp/notely-avd.log:"
      tail -20 /tmp/notely-avd.log >&2 || true
      die "emulator failed to start."
    fi
    serial=$(first_online_device)
    if [ -n "$serial" ]; then
      boot=$(adb -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r' | head -1 || true)
      if [ "$boot" = "1" ]; then
        return 0
      fi
    fi
    sleep 2
    elapsed=$((elapsed + 2))
  done
  return 1
}

device_abi() {
  local serial
  serial=$(first_online_device)
  [ -n "$serial" ] || return 0
  adb -s "$serial" shell getprop ro.product.cpu.abi 2>/dev/null | tr -d '\r' | sed '/^$/d' | head -1 || true
}

# Flutter target platforms: android-arm, android-arm64, android-x64, android-x86.
# Accepts both the device ABI names reported by `getprop ro.product.cpu.abi`
# (arm64-v8a, armeabi-v7a, x86_64, x86) and the short names `--help` advertises
# (arm64, arm, armv7) — the short ones used to fall through to "unknown --abi",
# so the documented command did not work.
to_flutter_platform() {
  case "$1" in
    arm64|arm64-v8a|aarch64)       echo android-arm64 ;;
    arm|armv7|armv7a|armeabi-v7a|armeabi) echo android-arm ;;
    x64|x86_64)                    echo android-x64 ;;
    x86|i686)                      echo android-x86 ;;
    *)                             echo "" ;;
  esac
}

# Boot an AVD first when asked so `abi auto` inspects the real emulator ABI.
if [ -n "$AVD" ] && [ -z "$(first_online_device)" ]; then
  command -v adb >/dev/null 2>&1 || die "adb is not available (install Android SDK platform-tools) — needed to wait for the AVD."
  if has_pending_device; then
    say "Waiting for the booting device/emulator…"
    wait_for_boot 120 "" || die "timed out waiting for the attached device/emulator to finish booting."
  else
    [ -n "$EMULATOR_BIN" ] || die "emulator binary not found under $SDK/emulator — install it via Android Studio or sdkmanager."
    AVDS=$("$EMULATOR_BIN" -list-avds 2>/dev/null | sed '/^$/d' || true)
    [ -n "$AVDS" ] || die "no AVDs configured — create one in Android Studio (Device Manager) first."
    if [ "$AVD" = "auto" ]; then
      AVD=$(printf '%s\n' "$AVDS" | head -1)
    elif ! printf '%s\n' "$AVDS" | grep -qx "$AVD"; then
      die "AVD '$AVD' not found. Available AVDs: $(printf '%s' "$AVDS" | tr '\n' ' ')"
    fi
    EMU_ARGS=(-avd "$AVD")

    # A stub-resolver host (systemd-resolved on 127.0.0.53) is the normal Fedora
    # setup, and it is exactly the state in which the booted AVD cannot resolve
    # anything. Fix it here instead of hoping the user remembers a flag.
    if [ -z "$DNS_SERVER" ] && [ "$NO_DNS_SERVER" != 1 ] && host_dns_is_stub; then
      DNS_SERVER=$(host_upstream_dns)
      if [ -n "$DNS_SERVER" ]; then
        say "host DNS is a local stub (systemd-resolved); giving the AVD this host's upstream resolver: $DNS_SERVER"
      else
        DNS_SERVER="8.8.8.8,1.1.1.1"
        say "host DNS is a local stub (systemd-resolved) and its upstream could not be read;"
        say "giving the AVD a public resolver instead: $DNS_SERVER"
      fi
      say "  (override with --dns-server=<ip>, or skip with --no-dns-server)"
    elif [ "$NO_DNS_SERVER" = 1 ]; then
      say "not passing -dns-server to the AVD (--no-dns-server)"
    fi

    if [ -n "$DNS_SERVER" ]; then
      case "$DNS_SERVER" in
        *[!0-9a-fA-F:.,]*) die "--dns-server '$DNS_SERVER' is not an address list (e.g. 8.8.8.8 or 8.8.8.8,1.1.1.1)." ;;
      esac
      EMU_ARGS+=(-dns-server "$DNS_SERVER")
    fi
    say "Starting AVD '$AVD'…${DNS_SERVER:+ (dns: $DNS_SERVER)}"
    nohup "$EMULATOR_BIN" "${EMU_ARGS[@]}" </dev/null >/tmp/notely-avd.log 2>&1 &
    EMU_PID=$!
    wait_for_boot 120 "$EMU_PID" || die "timed out waiting for AVD '$AVD' to boot (see /tmp/notely-avd.log)."
    AVD_BOOTED=1
    say "AVD '$AVD' is ready."

    # Say it now rather than leave it to be discovered as a mysterious
    # "Sign-in failed: ClientException with SocketException" minutes later.
    explain_dns_verdict "$(emulator_dns_verdict "$(first_online_device)")" "AVD '$AVD'"
  fi
fi

# An AVD that was already running when this script started keeps the resolver it
# booted with, so no boot flag can help it — and its broken DNS would surface much
# later, as a sign-in failure that looks like an OAuth bug (D-053). Say it here.
if [ "$INSTALL" = 1 ] && [ "$AVD_BOOTED" != 1 ]; then
  SERIAL=$(first_online_device)
  if [ -n "$SERIAL" ] && [ "$(adb -s "$SERIAL" shell getprop ro.kernel.qemu 2>/dev/null | tr -d '\r' | head -1 || true)" = "1" ]; then
    VERDICT=$(emulator_dns_verdict "$SERIAL")
    explain_dns_verdict "$VERDICT" "the running emulator ($SERIAL)"
    case "$VERDICT" in
      ok*) ;;
      *)
        RUNNING_AVD=$(timeout 10 adb -s "$SERIAL" emu avd name 2>/dev/null | head -1 | tr -d '\r' || true)
        warn "it keeps the resolver it booted with; rebooting it is one command:"
        warn "    adb -s $SERIAL emu kill && bin/build_apk --install --avd=${RUNNING_AVD:-<name>}"
        ;;
    esac
  fi
fi

# ---------------------------------------------------------------- device ABI
TOOLCHAIN=""
CHOSEN=""
case "$ABI" in
  all)  CHOSEN="all ABIs" ;;
  auto)
    DEV=$(device_abi)
    if [ -n "$DEV" ]; then
      P=$(to_flutter_platform "$DEV")
      [ -n "$P" ] || die "unknown device ABI '$DEV'; pass --abi all"
      TOOLCHAIN="--target-platform=$P"
      CHOSEN="$DEV (attached device)"
    else
      case "$(uname -m)" in
        x86_64|amd64) HOST=x86_64 ;;
        aarch64|arm64) HOST=arm64-v8a ;;
        *) HOST=arm64-v8a ;;
      esac
      P=$(to_flutter_platform "$HOST")
      TOOLCHAIN="--target-platform=$P"
      CHOSEN="$HOST (host arch; nothing attached — pass --avd or start the AVD before --install for an exact match)"
    fi
    ;;
  *)
    P=$(to_flutter_platform "$ABI")
    [ -n "$P" ] || die "unknown --abi '$ABI' (use auto, all, arm64, x86_64, arm or x86)"
    TOOLCHAIN="--target-platform=$P"
    CHOSEN="$ABI"
    ;;
esac

# `--target-platform` selects Flutter's engine and Dart snapshot; the plugins' .so
# files are still packaged for every ABI unless Gradle is told which ones to keep
# (`notelyAbi`). A phone-only release measured 40.5 MB with three ABIs of
# libobjectbox-jni.so inside it — 4.3 MB that device can never load.
case "$TOOLCHAIN" in
  *--target-platform=android-arm64) export ORG_GRADLE_PROJECT_notelyAbi="arm64-v8a" ;;
  *--target-platform=android-arm)   export ORG_GRADLE_PROJECT_notelyAbi="armeabi-v7a" ;;
  *--target-platform=android-x64)   export ORG_GRADLE_PROJECT_notelyAbi="x86_64" ;;
  *--target-platform=android-x86)   export ORG_GRADLE_PROJECT_notelyAbi="x86" ;;
  *)
    # --abi all: every ABI is wanted on purpose.
    unset ORG_GRADLE_PROJECT_notelyAbi 2>/dev/null || true ;;
esac

# ---------------------------------------------------------------- adapt to this SDK
# CI installs android-37 and the NDK the Flutter SDK pins. A local machine behind a
# network that cannot reach dl.google.com may have neither, and a build against what it
# does have is far more useful than a download error. Explicit flags win over this.
if [ -z "${ORG_GRADLE_PROJECT_notelyCompileSdk:-}" ] && [ -d "$SDK/platforms" ]; then
  if [ ! -d "$SDK/platforms/android-37" ]; then
    BEST_PAIR=$(ls -1 "$SDK/platforms" 2>/dev/null |
      sed -n 's/^android-\([0-9][0-9]*\)\.\([0-9][0-9]*\)$/\1 \2/p; s/^android-\([0-9][0-9]*\)$/\1 -1/p' |
      sort -t' ' -k1,1n -k2,2n | tail -1 || true)
    if [ -n "$BEST_PAIR" ]; then
      BEST_MAJOR=${BEST_PAIR%% *}
      BEST_MINOR=${BEST_PAIR#* }
      export ORG_GRADLE_PROJECT_notelyCompileSdk="$BEST_MAJOR"
      if [ "$BEST_MINOR" != "-1" ]; then
        export ORG_GRADLE_PROJECT_notelyCompileSdkMinor="$BEST_MINOR"
        BEST_LABEL="$BEST_MAJOR.$BEST_MINOR"
      else
        unset ORG_GRADLE_PROJECT_notelyCompileSdkMinor
        BEST_LABEL="$BEST_MAJOR"
      fi
      warn "android-37 is not installed → building against android-$BEST_LABEL (CI uses 37; pass --compile-sdk=37 when you have it)."
      if [ "$BEST_MAJOR" -lt 36 ] 2>/dev/null; then
        warn "note: plugin subprojects in android/build.gradle.kts require Android 36+ — if Gradle fails on platform 36, run: bin/android_doctor --fix"
      fi
    else
      FOUND_DIRS=$(ls "$SDK/platforms" 2>/dev/null | tr '\n' ' ' || true)
      warn "no android-<n> platform under $SDK/platforms (found: ${FOUND_DIRS:-none}) — run bin/android_doctor --fix first."
    fi
  fi
fi

valid_ndks() {
  [ -d "$SDK/ndk" ] || return 0
  for d in "$SDK"/ndk/*; do
    if [ -f "$d/source.properties" ]; then
      basename "$d"
    fi
  done | sort -V
}

valid_cmakes() {
  [ -d "$SDK/cmake" ] || return 0
  for d in "$SDK"/cmake/*; do
    if [ -x "$d/bin/cmake" ]; then
      basename "$d"
    fi
  done | sort -V
}

NEEDS_NDK=0
if [ -f pubspec.lock ] && grep -qE '^  jni(_flutter)?:$' pubspec.lock 2>/dev/null; then
  NEEDS_NDK=1
fi

FLUTTER_ROOT=$(cd "$(dirname "$(readlink -f "$FLUTTER")")/.." && pwd)
PINNED_NDK="28.2.13676358"
if [ -f "$FLUTTER_ROOT/packages/flutter_tools/lib/src/android/gradle_utils.dart" ]; then
  _pinned=$(sed -n "s/.*const ndkVersion = '\([^']*\)';.*/\1/p" "$FLUTTER_ROOT/packages/flutter_tools/lib/src/android/gradle_utils.dart" | head -1 || true)
  [ -n "$_pinned" ] && PINNED_NDK="$_pinned"
fi

INSTALLED_NDKS=$(valid_ndks)
INSTALLED_CMAKES=$(valid_cmakes)

if [ -z "${ORG_GRADLE_PROJECT_notelyNdkVersion:-}" ]; then
  if [ -z "$INSTALLED_NDKS" ]; then
    if [ "$NEEDS_NDK" = 1 ]; then
      die "no NDK installed under $SDK/ndk — transitive plugin :jni (from path_provider_android) compiles C code with CMake + NDK.

Install NDK + CMake from the SDK mirror with:
  bin/android_doctor --fix
(or via Android Studio → SDK Manager → SDK Tools → NDK (Side by side) & CMake)."
    else
      export ORG_GRADLE_PROJECT_notelyNdkVersion=none
      warn "no NDK installed → building without one (pass --ndk=<version> to force one)."
    fi
  else
    if ! printf '%s\n' "$INSTALLED_NDKS" | grep -qx "$PINNED_NDK"; then
      BEST_NDK=$(printf '%s\n' "$INSTALLED_NDKS" | tail -1)
      export ORG_GRADLE_PROJECT_notelyNdkVersion="$BEST_NDK"
      warn "ndk $PINNED_NDK is not installed → building with ndk $BEST_NDK (CI uses $PINNED_NDK)."
    fi
    if [ "$NEEDS_NDK" = 1 ] && [ -z "$INSTALLED_CMAKES" ]; then
      die "no CMake installed under $SDK/cmake — transitive plugin :jni builds C code with CMake.

Install CMake from the SDK mirror with:
  bin/android_doctor --fix
(or via Android Studio → SDK Manager → SDK Tools → CMake)."
    fi
  fi
elif [ "$ORG_GRADLE_PROJECT_notelyNdkVersion" = "none" ] && [ "$NEEDS_NDK" = 1 ]; then
  warn "--no-ndk requested, but transitive plugin :jni in pubspec.lock compiles CMake/NDK code — Gradle will fail on :jni unless NDK + CMake are installed or :jni is removed."
fi

# ---------------------------------------------------------------- dart-defines
sync_private_keys
DEFINES="bin/.tmp/private_keys/dart_defines/$FLAVOR.json"

# ---------------------------------------------------------------- signing
if [ "$MODE" = "release" ] && [ -z "${RELEASE_KEYSTORE_PATH:-}" ]; then
  DEBUG_KEYSTORE="$HOME/.android/debug.keystore"
  if [ "$SIGN_DEBUG" = 1 ] && [ -f "$DEBUG_KEYSTORE" ]; then
    # `--sign-debug`: a real release build (AOT Dart, R8, no VM) signed with the
    # standard Android debug key. Everything that makes the APK big is a property
    # of the build *type*; only the signature is the compromise, and that only
    # matters if you later want to update an install signed with a store/upload key.
    export RELEASE_KEYSTORE_PATH="$DEBUG_KEYSTORE"
    export RELEASE_KEYSTORE_PASSWORD="android"
    export RELEASE_KEY_ALIAS="androiddebugkey"
    export RELEASE_KEY_PASSWORD="android"
    warn "signing this release build with the Android DEBUG key ($DEBUG_KEYSTORE)."
    warn "Fine for your own phone today; a future build signed with your own key will not update it in place."
  else
    cat >&2 <<'EOF'
release builds need a keystore. Either export the four variables

  RELEASE_KEYSTORE_PATH=/abs/path/release.jks
  RELEASE_KEYSTORE_PASSWORD=...
  RELEASE_KEY_ALIAS=upload
  RELEASE_KEY_PASSWORD=...

or create one once (and keep it — losing it changes your app's identity):

  keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 \
          -validity 10000 -alias upload

Want the small/fast build right now, without creating anything? Sign the release
build with the Android debug key (already on this machine after any debug build):

  bin/build_apk --release --sign-debug --abi arm64

Use --debug if you just want something to install right now.
EOF
    exit 1
  fi
fi

# Release builds get their Dart symbols written outside the APK: they are what
# `flutter symbolize` needs for a stack trace, and nothing on a phone reads them.
SYMBOLS=""
if [ "$MODE" = "release" ]; then
  SYMBOLS="--split-debug-info=build/symbols"
fi

# ---------------------------------------------------------------- build
if [ -n "${ORG_GRADLE_PROJECT_notelyCompileSdk:-}" ]; then
  if [ -n "${ORG_GRADLE_PROJECT_notelyCompileSdkMinor:-}" ]; then
    say "compileSdk override: $ORG_GRADLE_PROJECT_notelyCompileSdk.$ORG_GRADLE_PROJECT_notelyCompileSdkMinor"
  else
    say "compileSdk override: $ORG_GRADLE_PROJECT_notelyCompileSdk"
  fi
fi
[ -n "${ORG_GRADLE_PROJECT_notelyNdkVersion:-}" ] && say "ndkVersion override: $ORG_GRADLE_PROJECT_notelyNdkVersion"

say "Building $FLAVOR ($MODE, $CHOSEN)…"
# shellcheck disable=SC2086 # $TOOLCHAIN and $VERBOSE are deliberately word-split (empty when unset)
"$FLUTTER" build apk --"$MODE" \
  --flavor="$FLAVOR" \
  --target="lib/main_$FLAVOR.dart" \
  --dart-define-from-file="$DEFINES" \
  $SYMBOLS $TOOLCHAIN $VERBOSE

APK="build/app/outputs/flutter-apk/app-$FLAVOR-$MODE.apk"
[ -f "$APK" ] || die "the build finished but $APK is missing — check the output above."

say "APK"
printf '  file    %s\n' "$APK"
printf '  size    %s\n' "$(du -h "$APK" | cut -f1)"
printf '  abi     %s\n' "$CHOSEN"
printf '  sha256  %s\n' "$(sha256sum "$APK" | cut -d' ' -f1)"
printf '  report  bin/apk_report %s\n' "$APK"

# ---------------------------------------------------------------- install
if [ "$INSTALL" = 1 ]; then
  command -v adb >/dev/null 2>&1 || die "adb is not on PATH and missing from $SDK/platform-tools."
  if [ -z "$(first_online_device)" ] && has_pending_device; then
    say "Waiting for device/emulator to finish booting…"
    wait_for_boot 90 "" || true
  fi
  DEVICES=$(adb devices 2>/dev/null | awk 'NF>=2 && $1!="*" && $2=="device"' | wc -l | tr -d ' ')
  if [ "$DEVICES" -lt 1 ]; then
    if [ -n "$EMULATOR_BIN" ]; then
      AVDS=$("$EMULATOR_BIN" -list-avds 2>/dev/null | sed '/^$/d' || true)
      if [ -n "$AVDS" ]; then
        FIRST_AVD=$(printf '%s\n' "$AVDS" | head -1)
        EMU_DISPLAY="${EMULATOR_BIN/#$HOME/\~}"
        die "nothing attached. Boot the AVD and install in one step:
  bin/build_apk --install --avd=$FIRST_AVD
or start it manually first:
  $EMU_DISPLAY -avd $FIRST_AVD &"
      fi
    fi
    die "no device in 'adb devices' — plug the phone in (USB debugging) or start an AVD.
For a phone: enable Developer options → USB debugging, accept the 'Allow USB debugging'
prompt on the device, then check that 'adb devices' lists it as 'device' (not 'unauthorized')."
  fi

  ADB_TARGET=()
  if [ -n "${ANDROID_SERIAL:-}" ]; then
    ADB_TARGET=(-s "$ANDROID_SERIAL")
  elif [ -n "$(first_online_device)" ]; then
    ADB_TARGET=(-s "$(first_online_device)")
    if [ "$DEVICES" -gt 1 ]; then
      say "note: $DEVICES devices attached — installing on the emulator ${ADB_TARGET[1]} (ANDROID_SERIAL overrides)."
    fi
  else
    die "multiple devices attached — set ANDROID_SERIAL to choose one:
$(adb devices)"
  fi

  say "Installing on ${ADB_TARGET[1]}…"
  # A debug-signed APK cannot replace a differently-signed install: say that in a
  # sentence instead of letting `adb install -r` fail with an error code.
  if ! adb "${ADB_TARGET[@]}" install -r "$APK" 2>&1 | tee /tmp/adb-install.log | grep -q Success; then
    if grep -q 'INSTALL_FAILED_UPDATE_INCOMPATIBLE' /tmp/adb-install.log; then
      die "the device has this app installed from a different signing key — run 'adb ${ADB_TARGET[*]} uninstall com.tc.writestory.$FLAVOR' first (it deletes the app's data too)."
    fi
    if grep -q 'INSTALL_FAILED_NO_MATCHING_ABIS' /tmp/adb-install.log; then
      die "the APK's ABI does not match the device — rebuild with --abi all (or --abi x86_64 for an x86_64 AVD)."
    fi
    die "adb install failed — see the lines above."
  fi
  if [ "$LAUNCH" = 1 ]; then
    PKG_NAME="$(get_package_name "$FLAVOR")"
    adb "${ADB_TARGET[@]}" shell am start -n "$PKG_NAME/com.tc.writestory.MainActivity" >/dev/null 2>&1 ||
      adb "${ADB_TARGET[@]}" shell monkey -p "$PKG_NAME" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true
    say "Installed and launched on ${ADB_TARGET[1]}."
  else
    say "Installed. Launch it from the app drawer (or pass --launch)."
  fi
else
  printf '\n  install with: adb install -r %s\n' "$APK"
fi

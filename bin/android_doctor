#!/usr/bin/env bash
# android_doctor — what this machine has, what the Android build needs, and what is missing.
#
#   bin/android_doctor            # full read-only report
#   bin/android_doctor --short    # only the verdict lines
#   bin/android_doctor --fix      # install the missing SDK packages with sdkmanager
#
# Prints one paste-able report: toolchain versions, SDK packages, AVDs and their ABIs,
# the Gradle/AGP/NDK the repo *and the pinned Flutter SDK* ask for, and whether Google
# Maven is reachable for the artifacts the Flutter Gradle plugin needs (a 403/404 there
# explains "Could not find apksig-x.y.z.jar" far better than the Gradle error does).
set -uo pipefail
cd "$(dirname "$0")/.."

SHORT=0
FIX=0
for arg in "$@"; do
  case "$arg" in
    --short) SHORT=1 ;;
    --fix)   FIX=1 ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "bin/android_doctor: unknown argument '$arg' (try --help)" >&2; exit 2 ;;
  esac
done

hdr() { [ "$SHORT" = 1 ] || printf '\n\033[1m== %s\033[0m\n' "$*"; }
row() { printf '  %-26s %s\n' "$1" "$2"; }
have() { command -v "$1" >/dev/null 2>&1; }
verdict_ok=(); verdict_bad=(); verdict_note=(); MISSING_PKGS=()
ok()   { verdict_ok+=("$*");   [ "$SHORT" = 1 ] || printf '  \033[32mok\033[0m      %s\n' "$*"; }
bad()  { verdict_bad+=("$*");  [ "$SHORT" = 1 ] || printf '  \033[31mMISSING\033[0m %s\n' "$*"; }
note() { verdict_note+=("$*"); [ "$SHORT" = 1 ] || printf '  \033[33mnote\033[0m    %s\n' "$*"; }

[ "$SHORT" = 1 ] || printf '\033[1mAndroid doctor\033[0m — %s on %s\n' "$(date -u +%Y-%m-%dT%H:%MZ)"

# ---------------------------------------------------------------- machine
hdr "machine"
row distro "$(sed -n 's/^PRETTY_NAME="\(.*\)"/\1/p' /etc/os-release 2>/dev/null | head -1)"
row kernel "$(uname -r)"
row cpus "$(nproc 2>/dev/null)"
row memory "$(free -h 2>/dev/null | awk 'NR==2{print $2}')"
row disk_here "$(df -h . | awk 'NR==2{print $4" free of "$2" on "$6}')"

# `grep -v` first: a commented-out `// compileSdk = flutter.compileSdkVersion` line
# would otherwise match with an empty number and report nothing.
gradle_value() { # file, property
  grep -v '^[[:space:]]*//' "$1" 2>/dev/null |
    sed -n "s/.*[[:space:]]$2[[:space:]]*=[[:space:]]*\([0-9][0-9]*\).*/\1/p" | head -1
}

# ---------------------------------------------------------------- repo
hdr "repo"
row branch "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
row commit "$(git log --oneline -1 2>/dev/null)"
row dirty "$(git status --porcelain 2>/dev/null | wc -l) file(s)"
row gradle_wrapper "$(sed -n 's/.*gradle-\(.*\)-\(all\|bin\)\.zip/\1/p' android/gradle/wrapper/gradle-wrapper.properties 2>/dev/null)"
row agp "$(sed -n 's/.*com\.android\.application") version "\([^"]*\)".*/\1/p' android/settings.gradle.kts 2>/dev/null)"
row kotlin "$(sed -n 's/.*org\.jetbrains\.kotlin\.android") version "\([^"]*\)".*/\1/p' android/settings.gradle.kts 2>/dev/null)"
COMPILE_SDK=$(gradle_value android/app/build.gradle.kts compileSdk)
MIN_SDK=$(gradle_value android/app/build.gradle.kts minSdk)
row compile_sdk "${COMPILE_SDK:-<unparsed>}"
row min_sdk "${MIN_SDK:-<unparsed>}"

# ---------------------------------------------------------------- toolchain
hdr "toolchain"
FLUTTER_ROOT=""
if have flutter; then
  FLUTTER_BIN=$(command -v flutter)
  FLUTTER_VERSION=$(flutter --version 2>/dev/null | head -1)
  row flutter "$(echo "$FLUTTER_VERSION" | cut -c1-60)"
  row flutter_path "$FLUTTER_BIN"
  FLUTTER_ROOT=$(cd "$(dirname "$(readlink -f "$FLUTTER_BIN")")/.." && pwd)
  case "$FLUTTER_VERSION" in
    *3.50.*) ok "flutter $(echo "$FLUTTER_VERSION" | awk '{print $2}')" ;;
    *) note "flutter is $(echo "$FLUTTER_VERSION" | awk '{print $2}'); CI pins 3.50.0" ;;
  esac
else
  bad "flutter not on PATH (install 3.50.0)"
fi

if have java; then
  JAVA_LINE=$(java -version 2>&1 | head -1)
  JAVA_MAJOR=$(printf '%s\n' "$JAVA_LINE" | sed -n 's/.*version "\([0-9]*\).*/\1/p')
  row java "$JAVA_LINE"
  row JAVA_HOME "${JAVA_HOME:-<unset>}"
  if [ "${JAVA_MAJOR:-0}" -ge 17 ] 2>/dev/null; then ok "JDK ${JAVA_MAJOR}"; else bad "JDK ${JAVA_MAJOR:-?} (need 17+)"; fi
else
  bad "no java on PATH (need JDK 17+)"
fi

# What the pinned Flutter SDK itself demands — these are the numbers Gradle enforces.
FLUTTER_NDK=""
FLUTTER_GRADLE=""
FLUTTER_AGP=""
if [ -n "$FLUTTER_ROOT" ]; then
  GU="$FLUTTER_ROOT/packages/flutter_tools/lib/src/android/gradle_utils.dart"
  if [ -f "$GU" ]; then
    pf() { sed -n "s/.*const $1 = '\([^']*\)';.*/\1/p" "$GU" | head -1; }
    FLUTTER_NDK=$(pf ndkVersion)
    FLUTTER_GRADLE=$(pf templateDefaultGradleVersion)
    FLUTTER_AGP=$(pf templateAndroidGradlePluginVersion)
    row flutter_pins "gradle ${FLUTTER_GRADLE:-?} / agp ${FLUTTER_AGP:-?} / ndk ${FLUTTER_NDK:-?}"
    AGP_HERE=$(sed -n 's/.*com\.android\.application") version "\([^"]*\)".*/\1/p' android/settings.gradle.kts 2>/dev/null)
    if [ -n "$FLUTTER_AGP" ] && [ -n "$AGP_HERE" ] && [ "$AGP_HERE" != "$FLUTTER_AGP" ]; then
      note "repo pins AGP $AGP_HERE, the Flutter template uses $FLUTTER_AGP (the repo's value wins; Flutter only enforces a minimum)"
    fi
  else
    note "could not read gradle_utils.dart from the Flutter SDK — NDK/platform pins unknown"
  fi
fi

# ---------------------------------------------------------------- android sdk
hdr "android sdk"
SDK="${ANDROID_SDK_ROOT:-${ANDROID_HOME:-}}"
[ -z "$SDK" ] && for guess in "$HOME/Android/Sdk" "$HOME/Library/Android/sdk" /usr/lib/android-sdk /opt/android-sdk; do
  [ -d "$guess" ] && { SDK="$guess"; break; }
done
SDKMANAGER=""
if [ -n "$SDK" ] && [ -d "$SDK" ]; then
  ok "ANDROID_HOME=$SDK"
  row sdk_path "$SDK"
  row disk_sdk "$(df -h "$SDK" | awk 'NR==2{print $4" free"}')"
  for c in "$SDK"/cmdline-tools/*/bin/sdkmanager "$SDK"/cmdline-tools/latest/bin/sdkmanager "$SDK"/tools/bin/sdkmanager; do
    [ -x "$c" ] && { SDKMANAGER="$c"; break; }
  done
  if [ -n "$SDKMANAGER" ]; then
    row sdkmanager "$SDKMANAGER"
    INSTALLED=$(timeout 180 "$SDKMANAGER" --list_installed 2>/dev/null | sed -n '/Installed packages:/,$p' | sed '1d' | awk '{print $1}' | sed '/^$/d')
    row platforms "$(printf '%s\n' "$INSTALLED" | grep '^platforms;android-' | sed 's/platforms;android-//' | sort -n | tr '\n' ' ')"
    row build_tools "$(printf '%s\n' "$INSTALLED" | grep '^build-tools;' | sed 's/build-tools;//' | sort -V | tr '\n' ' ')"
    row ndk "$(printf '%s\n' "$INSTALLED" | grep '^ndk;' | sed 's/ndk;//' | sort -V | tr '\n' ' ')"
    row cmake "$(printf '%s\n' "$INSTALLED" | grep '^cmake;' | sed 's/cmake;//' | sort -V | tr '\n' ' ')"
    row platform_tools "$(printf '%s\n' "$INSTALLED" | grep -q '^platform-tools' && echo installed || echo missing)"
    row emulator "$(printf '%s\n' "$INSTALLED" | grep -q '^emulator' && echo installed || echo missing)"

    if [ -n "$COMPILE_SDK" ]; then
      if printf '%s\n' "$INSTALLED" | grep -qx "platforms;android-$COMPILE_SDK"; then
        ok "platform android-$COMPILE_SDK"
      else
        bad "platform android-$COMPILE_SDK (compileSdk in android/app/build.gradle.kts)"
        MISSING_PKGS+=("platforms;android-$COMPILE_SDK")
      fi
    fi
    if [ -n "$FLUTTER_NDK" ]; then
      if printf '%s\n' "$INSTALLED" | grep -qx "ndk;$FLUTTER_NDK"; then
        ok "ndk $FLUTTER_NDK (pinned by Flutter ${FLUTTER_VERSION#Flutter })"
      else
        bad "ndk $FLUTTER_NDK (android/app/build.gradle.kts sets ndkVersion = flutter.ndkVersion)"
        MISSING_PKGS+=("ndk;$FLUTTER_NDK")
      fi
    fi
    if ! printf '%s\n' "$INSTALLED" | grep -q '^build-tools;'; then
      bad "build-tools"
      MISSING_PKGS+=("build-tools;37.0.0")
    fi
    if ! printf '%s\n' "$INSTALLED" | grep -q '^platform-tools'; then
      bad "platform-tools (adb lives here)"
      MISSING_PKGS+=("platform-tools")
    fi
    printf '%s\n' "$INSTALLED" | grep -q '^emulator' || note "emulator package not installed (only needed for AVDs)"
    printf '%s\n' "$INSTALLED" | grep -q '^cmake;' || note "cmake not installed — Gradle downloads it only if a plugin has native code"
  else
    note "sdkmanager not found under $SDK (cmdline-tools missing) — package checks skipped"
  fi
else
  bad "no Android SDK (set ANDROID_HOME; Android Studio ships it)"
  SDK=""
fi

# ---------------------------------------------------------------- devices & avds
hdr "devices and AVDs"
if have adb; then
  row adb "$(adb version 2>/dev/null | head -1)"
  DEVICES=$(timeout 30 adb devices -l 2>/dev/null | sed -n '2,$p' | sed '/^$/d')
  if [ -n "$DEVICES" ]; then
    printf '%s\n' "$DEVICES" | while IFS= read -r line; do row device "$line"; done
    ABI_DEV=$(timeout 20 adb shell getprop ro.product.cpu.abi 2>/dev/null | tr -d '\r' | head -1)
    [ -n "$ABI_DEV" ] && ok "attached device ABI $ABI_DEV (bin/build_apk --abi auto follows it)"
  else
    note "no device/emulator attached ('adb devices' is empty)"
  fi
else
  bad "adb not on PATH (install platform-tools)"
fi

EMULATOR=""
have emulator && EMULATOR=$(command -v emulator)
[ -z "$EMULATOR" ] && [ -n "$SDK" ] && [ -x "$SDK/emulator/emulator" ] && EMULATOR="$SDK/emulator/emulator"
if [ -n "$EMULATOR" ]; then
  AVDS=$(timeout 30 "$EMULATOR" -list-avds 2>/dev/null | sed '/^$/d')
  if [ -n "$AVDS" ]; then
    while IFS= read -r avd; do
      CFG="$HOME/.android/avd/$avd.avd/config.ini"
      ABI=$(sed -n 's/^abi\.type=//p' "$CFG" 2>/dev/null | head -1)
      row "avd $avd" "${ABI:-abi unknown}"
    done <<< "$AVDS"
    ok "AVDs present — start one, then bin/build_apk --install"
  else
    note "emulator installed but no AVDs (avdmanager create avd -n pixel -k \"system-images;android-36;google_apis;x86_64\")"
  fi
else
  note "emulator binary not found — AVD checks skipped"
fi

# ---------------------------------------------------------------- network
hdr "google maven reachability"
NET_BLOCKED=0
if have curl; then
  probe() { curl -s -o /dev/null -m 25 -w '%{http_code}' "$1" 2>/dev/null; }
  for path in \
    "com/android/tools/build/gradle/9.1.1/gradle-9.1.1.pom" \
    "com/android/tools/build/apksig/9.1.1/apksig-9.1.1.jar" \
    "com/android/tools/build/apkzlib/9.1.1/apkzlib-9.1.1.jar" \
    "com/android/tools/build/gradle/9.1.1/gradle-9.1.1.jar" ; do
    code=$(probe "https://dl.google.com/dl/android/maven2/$path")
    [ "$SHORT" = 1 ] || printf '  %-58s %s\n' "$path" "$code"
    case "$code" in
      200) : ;;
      403|451) bad "dl.google.com returns $code for $(basename "$path") — region/proxy block, not a build bug"; NET_BLOCKED=1 ;;
      404) bad "dl.google.com returns 404 for $(basename "$path") — stale Gradle metadata cache (see the note below)"; NET_BLOCKED=2 ;;
      000|"") note "could not reach dl.google.com at all ($(basename "$path"))"; NET_BLOCKED=1 ;;
    esac
  done
  code=$(probe "https://repo.maven.apache.org/maven2/org/jetbrains/kotlin/kotlin-gradle-plugin/2.4.10/kotlin-gradle-plugin-2.4.10.pom")
  [ "$SHORT" = 1 ] || printf '  %-58s %s\n' "maven central (kotlin-gradle-plugin 2.4.10)" "$code"
  [ "$code" = "200" ] || note "maven central unreachable too — a proxy is likely the cause"
else
  note "curl not found — reachability checks skipped"
fi

[ -d "$HOME/.gradle/init.d" ] && {
  hdr "gradle init scripts (can replace repositories)"
  for f in "$HOME/.gradle/init.d"/*; do [ -f "$f" ] && row "$(basename "$f")" "$(grep -c . "$f") lines"; done
}
[ -f "$HOME/.gradle/gradle.properties" ] && {
  hdr "user gradle.properties"
  sed 's/^/  /' "$HOME/.gradle/gradle.properties"
}

# ---------------------------------------------------------------- verdict
printf '\n\033[1m== verdict\033[0m\n'
for v in "${verdict_ok[@]}"; do printf '  \033[32mok\033[0m      %s\n' "$v"; done
for v in "${verdict_note[@]}"; do printf '  \033[33mnote\033[0m    %s\n' "$v"; done
for v in "${verdict_bad[@]}"; do printf '  \033[31mMISSING\033[0m %s\n' "$v"; done

case "$NET_BLOCKED" in
  1) printf '\n  Network: Google Maven is unreachable/blocked. Add a mirror in \033[1m~/.gradle/init.d/google-mirror.gradle.kts\033[0m\n  (maven("https://maven.aliyun.com/repository/google") before google()) or point Gradle at your proxy.\n' ;;
  2) printf '\n  Network: Google Maven answers but not for these files — most likely a stale Gradle cache.\n  Try: rm -rf ~/.gradle/caches/modules-2 && bin/build_apk\n' ;;
esac

if [ "${#MISSING_PKGS[@]}" -gt 0 ]; then
  printf '\n  Missing packages: %s\n' "${MISSING_PKGS[*]}"
  if [ "$FIX" = 1 ] && [ -n "$SDKMANAGER" ]; then
    printf '  Installing with: %s --install %s\n' "$SDKMANAGER" "${MISSING_PKGS[*]}"
    yes | "$SDKMANAGER" --licenses >/dev/null 2>&1
    "$SDKMANAGER" --install "${MISSING_PKGS[@]}" || printf '\033[31m  sdkmanager failed — see its output above\033[0m\n'
  else
    printf '  Install them with: sdkmanager --install %s   (or re-run with --fix)\n' "${MISSING_PKGS[*]}"
  fi
elif [ "${#verdict_bad[@]}" -eq 0 ]; then
  printf '\n  Nothing missing: run \033[1mbin/build_apk --install\033[0m (it picks the ABI of the attached device/AVD).\n'
fi

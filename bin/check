#!/bin/bash

# Local pre-push check - the same gates CI runs, without waiting for CI.
#
#   bin/check            # format (write) + analyze errors + tests
#   bin/check --no-format  # skip the formatter
#
# Exit code is non-zero if anything fails, so it is safe to use in a hook.
#
# CI is still the source of truth (it builds the real Linux binary), but this
# catches the cheap stuff in seconds instead of six minutes.

set -uo pipefail

RED=$'\033[31m'; GREEN=$'\033[32m'; YELLOW=$'\033[33m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
step() { echo; echo "${BOLD}==> $*${RESET}"; }
ok()   { echo "${GREEN}  ok${RESET}  $*"; }
fail() { echo "${RED}  err${RESET}  $*"; }

cd "$(dirname "$0")/.." || exit 1

if [ -n "${FLUTTER_BIN:-}" ]; then
  FLUTTER="$FLUTTER_BIN"
elif command -v flutter >/dev/null 2>&1; then
  FLUTTER="$(command -v flutter)"
elif [ -x "$HOME/development/flutter_stable/bin/flutter" ]; then
  FLUTTER="$HOME/development/flutter_stable/bin/flutter"
else
  fail "Flutter not found. Set FLUTTER_BIN or install the SDK (see ai/ENVIRONMENT.md)."
  exit 1
fi

DART="${FLUTTER%/flutter}/dart"
[ -x "$DART" ] || DART="$(command -v dart)"

status=0

if [ "${1:-}" != "--no-format" ]; then
  step "dart format (lib, test)"
  if "$DART" format --line-length=120 \
    $(find lib test -name "*.dart" -not -name "*.g.dart" -not -name "*.gen.dart" \
        -not -name "*.mocks.dart" -not -path "*/firebase_options/*") > /dev/null; then
    ok "formatted"
  else
    fail "formatter failed"; status=1
  fi
fi

step "flutter analyze"
# Infos/warnings are pre-existing upstream noise; only analyser errors matter
# (same policy as .github/workflows/linux.yml).
if "$FLUTTER" analyze --no-fatal-infos --no-fatal-warnings > /tmp/sp_analyze.log 2>&1; then
  ok "no analyzer errors"
else
  fail "analyzer errors:"
  tail -30 /tmp/sp_analyze.log
  status=1
fi

step "flutter test"
if "$FLUTTER" test > /tmp/sp_test.log 2>&1; then
  ok "$(grep -oE '\+[0-9]+' /tmp/sp_test.log | tail -1) tests passed"
else
  fail "tests failed:"
  grep -E "^[0-9:]+ \+[0-9]+ -[0-9]+|Failed|Error" /tmp/sp_test.log | tail -30
  status=1
fi

echo
if [ "$status" -eq 0 ]; then
  echo "${GREEN}${BOLD}All local checks passed.${RESET} CI will still build the Linux binary."
else
  echo "${RED}${BOLD}Checks failed.${RESET} See above."
fi
exit "$status"
